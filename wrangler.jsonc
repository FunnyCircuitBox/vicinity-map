// Cloudflare settings for Vicinity Map.
// "main" = the backend code. "assets" = the public website files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vicinity-map",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
