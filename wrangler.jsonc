// Cloudflare settings for Vicinity.
// "main" = backend code. "assets" = public website files.
// "build" runs before every deploy: fonts are copied in, then every test must pass.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vicinity-map",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // City claims database. Cloudflare creates it automatically on the first deploy;
  // the tables are created by the code the first time they're used.
  "d1_databases": [{ "binding": "DB", "database_name": "vicinity-claims" }],
  "observability": { "enabled": true }
}
