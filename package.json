{
  "name": "vicinity-map",
  "version": "0.1.0",
  "private": true,
  "description": "Represent your city. A community map for local memes, check-ins and city leaderboards.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/copy-fonts.mjs && npm test",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "check:boundaries": "node scripts/boundaries/check-overlaps.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "d3-delaunay": "6.0.4",
    "polygon-clipping": "0.15.7",
    "wrangler": "4.137.0"
  },
  "engines": {
    "node": ">=20"
  }
}
